{
  "info": {
    "name": "Autocare isolated local finance read-only records",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:1"
    },
    {
      "key": "isolated_local_finance_cases",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.variables.get(\"isolated_local_finance_cases\")!==\"true\"){pm.execution.skipRequest();throw new Error(\"Use the isolated fulfillment runner\");}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "local_daily_exact",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/admin/reconciliation?date=2026-10-20&channel=LOCAL_TEST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{operator_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status\",()=>pm.response.to.have.status(200));",
              "pm.test(\"envelope\",()=>{pm.expect(pm.response.json().code).to.eql(0);});",
              "pm.test(\"no-store\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"business 0\",()=>{const d=pm.response.json().data;pm.expect(d.payments).to.eql({state:\"KNOWN\",success_count:2,anomaly_count:0,other_count:1,amount:\"0.03\"});});",
              "pm.test(\"business 1\",()=>{const d=pm.response.json().data;pm.expect(d.refunds).to.eql({state:\"KNOWN\",success_count:1,anomaly_count:0,other_count:0,amount:\"0.05\"});pm.expect(d.local_net).to.eql({state:\"KNOWN\",amount:\"-0.02\"});});",
              "pm.test(\"business 2\",()=>{const d=pm.response.json().data;pm.expect(d.window_from).to.eql(\"2026-10-19T16:00:00Z\");pm.expect(d.window_to).to.eql(\"2026-10-20T16:00:00Z\");pm.expect(d.unclassified_count).to.eql(0);});",
              "pm.test(\"business 3\",()=>{const d=pm.response.json().data;pm.expect(d.date).to.eql(\"2026-10-20\");pm.expect(d.channel).to.eql(\"LOCAL_TEST\");pm.expect(d.test_mode).to.eql(true);});",
              "pm.test(\"business 4\",()=>{const d=pm.response.json().data;pm.expect(d.timezone).to.eql(\"Asia/Shanghai\");pm.expect(d.currency).to.eql(\"CNY\");pm.expect(d.source_version).to.eql(\"R9_LOCAL_FINANCE_V1\");});",
              "pm.test(\"business 5\",()=>{pm.expect(pm.response.json().data.channel_statement).to.eql({state:\"UNAVAILABLE\",net_amount:null,difference:null});});",
              "pm.test(\"business 6\",()=>{for(const k of [\"user_id\",\"order_id\",\"payment_no\",\"channel_payment_no\",\"phone\",\"openid\",\"session\",\"merchant_id\"])pm.expect(pm.response.text()).not.to.include(\"\\\"\"+k+\"\\\"\");});"
            ]
          }
        }
      ]
    },
