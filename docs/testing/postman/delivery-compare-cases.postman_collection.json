{
  "info": {
    "name": "Autocare isolated pickup delivery comparison",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:1"
    },
    {
      "key": "isolated_delivery_compare_cases",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.variables.get(\"isolated_delivery_compare_cases\")!==\"true\"){pm.execution.skipRequest();throw new Error(\"Use the isolated fulfillment runner\");}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "delivery_ready",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/check/delivery/compare",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "ff28b132-d272-5704-9fe3-92cefcb3fa6d"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{owner_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"order_id\": 301}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status\",()=>pm.response.to.have.status(200));",
              "pm.test(\"envelope\",()=>{pm.expect(pm.response.json().code).to.eql(0);});",
              "pm.test(\"no-store\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"business 0\",()=>{const d=pm.response.json().data;pm.expect(d.order_id).to.eql(301);pm.expect(d.order_status).to.eql(\"PENDING_VERIFY\");});",
              "pm.test(\"business 1\",()=>{const d=pm.response.json().data;pm.expect(d.result).to.eql(\"READY\");pm.expect(d.deliverable).to.eql(true);pm.expect(d.missing).to.eql([]);});",
              "pm.test(\"business 2\",()=>{const b=pm.response.json().data.baseline;pm.expect(b.mileage).to.eql(120);pm.expect(b.mileage_delta).to.eql(0);pm.expect(b.fuel_level).to.eql(\"HALF\");pm.expect(b.damage_status).to.eql(\"NONE\");pm.expect(b.damage_count).to.eql(0);pm.expect(b.owner_confirm).to.eql(1);});",
              "pm.test(\"business 3\",()=>{const b=pm.response.json().data.baseline;pm.expect(b.photo_count).to.eql(7);pm.expect(b.photo_slots).to.eql([\"DASHBOARD\", \"FRONT\", \"INTERIOR\", \"LEFT\", \"REAR\", \"RIGHT\", \"ROOF\"]);});",
              "pm.test(\"business 4\",()=>{const w=pm.response.json().data.work;pm.expect(w.protection).to.eql({submitted:true,item_count:2,photo:true});});",
              "pm.test(\"business 5\",()=>{const r=pm.response.json().data.work.report;pm.expect(r.status).to.eql(\"SIGNED\");pm.expect(r.submitted).to.eql(true);pm.expect(r.process_photos).to.eql(1);pm.expect(r.finish_photos).to.eql(1);pm.expect(r.fault_photos).to.eql(0);pm.expect(r.signature_photos).to.eql(1);pm.expect(r.no_fault_parts).to.eql(true);});",
              "pm.test(\"business 6\",()=>{for(const k of [\"user_id\",\"owner_id\",\"staff_id\",\"technician_id\",\"phone\",\"openid\",\"object_key\",\"report_id\",\"pickup_check_file\"])pm.expect(pm.response.text()).not.to.include(\"\\\"\"+k+\"\\\"\");});"
            ]
          }
        }
      ]
    },
