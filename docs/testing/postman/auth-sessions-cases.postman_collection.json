    {
      "name": "refresh_owner",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/refresh",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refresh_token\": \"{{owner_refresh}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status\",()=>pm.response.to.have.status(200));",
              "pm.test(\"envelope\",()=>{pm.expect(pm.response.json().code).to.eql(0);});",
              "pm.test(\"no-store\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"business 0\",()=>{const d=pm.response.json().data;pm.expect(d.token_type).to.eql(\"Bearer\");pm.expect(d.expires_in).to.eql(900);pm.expect(d.refresh_token).to.match(/^[A-Za-z0-9_-]{43}$/);pm.expect(d.refresh_token).not.to.eql(pm.environment.get(\"owner_refresh\"));pm.expect(d.user.role).to.eql(\"owner\");pm.expect(Object.keys(d).sort()).to.eql([\"access_token\",\"expires_in\",\"refresh_token\",\"token_type\",\"user\"]);});",
              "pm.test(\"business 1\",()=>{const d=pm.response.json().data;pm.collectionVariables.set(\"owner_new_token\",d.access_token);pm.collectionVariables.set(\"owner_next_refresh\",d.refresh_token);});"
            ]
          }
        }
      ]
