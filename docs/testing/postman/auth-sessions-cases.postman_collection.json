{
  "info": {
    "name": "Autocare isolated auth session rotation and revocation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:1"
    },
    {
      "key": "isolated_auth_sessions_cases",
      "value": "false"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.variables.get(\"isolated_auth_sessions_cases\")!==\"true\"){pm.execution.skipRequest();throw new Error(\"Use the isolated fulfillment runner\");}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "session_vehicle",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/vehicle/list",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{owner_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status\",()=>pm.response.to.have.status(200));",
              "pm.test(\"envelope\",()=>{pm.expect(pm.response.json().code).to.eql(0);});",
              "pm.test(\"no-store\",()=>pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
              "pm.test(\"business 0\",()=>{pm.expect(pm.response.json().data.list.map(i=>i.vehicle_id)).to.eql([1]);});"
            ]
          }
        }
      ]
    },
