# Public client configuration only. Never put AppSecret here.
#
# 二选一：
#
# 1) 本机 / 开发者工具 / H5 联调：填可访问的后端地址，请求走 uni.request。
VITE_API_BASE_URL=
#
# 2) 微信云托管（免配通讯域名）：同时填环境 ID 与服务名称，请求改走 wx.cloud.callContainer，
#    此时 VITE_API_BASE_URL 会被忽略。两个变量都为空即回退到方案 1。
VITE_WECHAT_CLOUD_ENV_ID=
VITE_WECHAT_CLOUD_SERVICE=
