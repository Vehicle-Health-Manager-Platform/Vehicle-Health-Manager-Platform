# 微信云托管服务环境变量模板。真实值只在云托管控制台填写，不提交、不粘贴到聊天或工单。
#
# 与 .env.example 的差异：
# - SERVER_PORT 用云托管「服务设置」的监听端口（默认 80）。
# - MYSQL_HOST 指向容器外的数据库实例：云托管不支持部署有状态服务。
# - WECHAT_CLOUD_RUN_ENABLED 只在服务已关闭公网访问、且小程序改用 callContainer 后设为 true。

SERVER_PORT=80

MYSQL_HOST=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

JWT_SECRET=

WECHAT_APP_ID=wxc17878d92f30a01f
WECHAT_APP_SECRET=

WECHAT_CLOUD_RUN_ENABLED=true

SMS_PROVIDER=unconfigured
# 车主端 AI 管家（DeepSeek）。密钥只填在云托管控制台的环境变量里。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled

UPLOAD_STORAGE_ENABLED=false
UPLOAD_SCAN_ENABLED=false
UPLOAD_ALLOW_INSECURE=false
