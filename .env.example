# Local development only. Copy to .env and replace every secret with a private value.
SERVER_PORT=8080
OCR_PORT=8090
MYSQL_DATABASE=vehicle_health
MYSQL_USER=vehicle_health
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me
RABBITMQ_USER=vehicle_health
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_USER=vehicle_health
MINIO_ROOT_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-32-byte-secret
# Public test AppID; keep the rotated AppSecret only in a private local or deployment environment.
WECHAT_APP_ID=wxc17878d92f30a01f
WECHAT_APP_SECRET=unconfigured
SMS_PROVIDER=unconfigured
AI_PROVIDER=unconfigured
# Opt-in upload adapters; root MinIO credentials are never application upload credentials.
UPLOAD_STORAGE_ENABLED=false
UPLOAD_SCAN_ENABLED=false
UPLOAD_ALLOW_INSECURE=false
MINIO_ENDPOINT=https://storage.example.invalid
MINIO_PUBLIC_ENDPOINT=
UPLOAD_MINIO_BUCKET=vehicle-uploads
UPLOAD_MINIO_ACCESS_KEY=unconfigured
UPLOAD_MINIO_SECRET_KEY=unconfigured
UPLOAD_MINIO_REGION=us-east-1
UPLOAD_STORAGE_TIMEOUT_MS=10000
UPLOAD_SIGNED_URL_SECONDS=120
CLAMAV_HOST=unconfigured
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_SCAN_TIMEOUT_MS=30000

# Owner HTTP upload admission and reconciliation
UPLOAD_HTTP_CONCURRENCY=4
UPLOAD_CLEANUP_INTERVAL_MS=60000
