# Local development only. Copy to .env and replace every secret with a private value.
SERVER_PORT=8080
OCR_PORT=8090
MYSQL_DATABASE=vehicle_health
# Backend direct connection port; defaults to 3306. Compose keeps its internal MySQL port.
MYSQL_PORT=3306
MYSQL_USER=vehicle_health
MYSQL_PASSWORD=change-me
# JDBC pool size; defaults to 10. Size it from measured concurrency (see docs/operations/PERFORMANCE_CAPACITY_RUNBOOK.md).
MYSQL_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=change-me-root
REDIS_PASSWORD=change-me
RABBITMQ_USER=vehicle_health
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_USER=vehicle_health
MINIO_ROOT_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-32-byte-secret
# Public test AppID; keep the rotated AppSecret only in a private local or deployment environment.
WECHAT_APP_ID=wxc17878d92f30a01f
WECHAT_APP_SECRET=unconfigured
# 微信云托管身份入口。只有在服务已关闭公网访问、且小程序改用 callContainer 后才可设为 true。
WECHAT_CLOUD_RUN_ENABLED=false
SMS_PROVIDER=unconfigured
# 车主端 AI 管家（DeepSeek）。留空或 unconfigured 时 /api/ai/chat 返回 50301 降级，不影响其他功能。
# ⚠️ 本文件是被 Git 跟踪的模板，只放占位值。真实密钥写在 .env.auth-backend.local 等 *.local 私有文件里（已被 .gitignore 忽略）。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash 对应 DeepSeek-V4.1-Flash（非思考，默认最快最省）；也可改为 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-flash
# enabled 会开启思考模式，延迟与费用更高；默认关闭。
DEEPSEEK_THINKING=disabled
# Opt-in upload adapters; root MinIO credentials are never application upload credentials.
UPLOAD_STORAGE_ENABLED=false
UPLOAD_SCAN_ENABLED=false
UPLOAD_ALLOW_INSECURE=false
MINIO_ENDPOINT=https://storage.example.invalid
MINIO_PUBLIC_ENDPOINT=
UPLOAD_MINIO_BUCKET=vehicle-uploads
UPLOAD_MINIO_ACCESS_KEY=unconfigured
UPLOAD_MINIO_SECRET_KEY=unconfigured
UPLOAD_MINIO_REGION=us-east-1
UPLOAD_STORAGE_TIMEOUT_MS=10000
UPLOAD_SIGNED_URL_SECONDS=120
CLAMAV_HOST=unconfigured
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_SCAN_TIMEOUT_MS=30000

# Owner HTTP upload admission and reconciliation
UPLOAD_HTTP_CONCURRENCY=4
UPLOAD_CLEANUP_INTERVAL_MS=60000
INPUT_MATERIAL_UPLOAD_ENABLED=false

# Deploy V017 and the archive UI before enabling the database outbox consumer.
SERVICE_ARCHIVE_ENABLED=false
SERVICE_ARCHIVE_INTERVAL_MS=60000
SERVICE_NOTIFICATION_DELAY_MS=5000

# Apply V018 and upgrade the owner UI before generating new private experience drafts.
# Completed historical archives are not backfilled. This flag never publishes cards.
EXPERIENCE_CARD_ENABLED=false

# Apply V019 and upgrade the WeChat miniapp before allowing moderation/public experiences.
EXPERIENCE_PUBLICATION_ENABLED=false

# Apply V020 and upgrade the owner/operator pages before allowing merchant onboarding.
# Approval never issues an initial password; store accounts stay PENDING_ACTIVATION until R9.
MERCHANT_ONBOARDING_ENABLED=false
# R6a: enable only after R9 official identity evidence acceptance; no client proof flags.
INVITE_VERIFIED_IDENTITY_ENABLED=false
INVITE_REWARD_ENABLED=false

# Apply V021 and upgrade the merchant pages before allowing store staff management.
# Turning it off makes every staff/profile endpoint (including reads) return 50300.
MERCHANT_STAFF_ENABLED=false

# Apply V024 before payment query recovery. Test-only loopback supplier, never WeChat Pay.
PAYMENT_QUERY_RECOVERY_ENABLED=false
PAYMENT_QUERY_RECOVERY_INTERVAL_MS=60000
PAYMENT_LOCAL_TEST_QUERY_URL=

# Apply V025 first; uses the isolated supplier at PAYMENT_LOCAL_TEST_QUERY_URL.
REFUND_RECOVERY_ENABLED=false
REFUND_RECOVERY_INTERVAL_MS=60000

# Public review text submission/moderation; keep false until operator review is configured.
REVIEW_TEXT_PUBLICATION_ENABLED=false

# Opt-in, source-checked review extracts; requires independent author AI consent.
REVIEW_SUMMARY_ENABLED=false

# Structured live-catalog AI suggestions; explicit question-purpose consent required.
AI_SERVICE_PLAN_ENABLED=false

# R8 verified task ledger, disabled until formal evidence is accepted in R9.
POINTS_EXCHANGE_ENABLED=false
POINTS_EARNING_ENABLED=false
POINTS_VERIFIED_IDENTITY_ENABLED=false
POINTS_AI_VERIFIED_ENABLED=false
POINTS_RECOVERY_DELAY_MS=5000

# R8c1b3: explicit public QA consent/review only; formal identity remains R9.
COMMUNITY_PUBLICATION_ENABLED=false
PUBLIC_IMAGES_ENABLED=false
KNOWLEDGE_ENABLED=false
KNOWLEDGE_AI_ENABLED=false

# Private mileage OCR gateway; keep credentials on the backend only.
MILEAGE_OCR_ENABLED=false
MILEAGE_OCR_URL=
MILEAGE_OCR_SERVICE_TOKEN=
MILEAGE_OCR_ALLOW_PRIVATE_HTTP=false
# Optional Linux OCR overlay only: absolute verified model/wheel directories.
OCR_MODELS_ROOT=
OCR_WHEELHOUSE_ROOT=

# VIN read-only owner gateway; fixed NHTSA endpoint, US-market coverage only.
VIN_DECODE_ENABLED=false
VIN_DECODER_PROVIDER=unconfigured

# Optional new-vehicle license OCR; private backend service only, independent opt-in.
LICENSE_OCR_ENABLED=false
LICENSE_OCR_URL=
LICENSE_OCR_SERVICE_TOKEN=
LICENSE_OCR_ALLOW_PRIVATE_HTTP=false

# Durable ASR jobs; private service and verified local model remain separately disabled.
ASR_ENABLED=false
ASR_URL=
ASR_SERVICE_TOKEN=
ASR_ALLOW_PRIVATE_HTTP=false
ASR_JOB_INTERVAL_MS=1000
ASR_CLEANUP_INTERVAL_MS=60000

# Document candidates: private service/model must be independently enabled after acceptance.
DOCUMENT_ENABLED=false
DOCUMENT_URL=
DOCUMENT_SERVICE_TOKEN=
DOCUMENT_ALLOW_PRIVATE_HTTP=false
DOCUMENT_JOB_INTERVAL_MS=1000
DOCUMENT_CLEANUP_INTERVAL_MS=60000
DOCUMENT_SERVICE_ENABLED=false
DOCUMENT_CORE_ENABLED=false
DOCUMENT_PORT=8092
